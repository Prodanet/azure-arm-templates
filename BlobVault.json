{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.9",
    "parameters": {
        "vaultName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Blob Backup Vault."
            }
        },
        "resourceGroupName": {
            "type": "string",
            "metadata": {
                "description": "Name of the resource group where the Blob Backup Vault and storage account will be created."
            }
        },
        "storageAccountName": {
            "type": "string",
            "metadata": {
                "description": "Name of the storage account."
            }
        },
        "backupRetentionDays": {
            "type": "int",
            "defaultValue": 1,
            "minValue": 0,
            "maxValue": 360,
            "metadata": {
                "description": "Number of daily recovery points to retain for blob storage vaulted backup. Set to 0 to disable blob backup entirely."
            }
        },
        "resourceGroupLocation": {
            "type": "string",
            "metadata": {
                "description": "Location of the resource group where the storage account is located."
            }
        }
    },
    "variables": {
        "subscriptionId": "[subscription().subscriptionId]",
        "backupInstanceName": "[concat(parameters('storageAccountName'), '-', parameters('storageAccountName'), '-', guid(parameters('storageAccountName')))]",
        "roleAssignmentName": "[guid(parameters('vaultName'), parameters('storageAccountName'), 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "blobBackupPolicyName": "[concat(parameters('vaultName'), '/BlobDailyPolicy')]"
    },
    "resources": [
        {
            "type": "Microsoft.DataProtection/backupVaults",
            "apiVersion": "2026-03-01",
            "name": "[parameters('vaultName')]",
            "location": "[parameters('resourceGroupLocation')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "storageSettings": [
                    {
                        "datastoreType": "VaultStore",
                        "type": "LocallyRedundant"
                    }
                ],
                "securitySettings": {
                    "softDeleteSettings": {
                        "state": "AlwaysOn"
                    }
                }
            }
        },
        {
            "type": "Microsoft.DataProtection/BackupVaults/backupPolicies",
            "apiVersion": "2026-03-01",
            "name": "[variables('blobBackupPolicyName')]",
            "dependsOn": [
                "[resourceId('Microsoft.DataProtection/BackupVaults', parameters('vaultName'))]"
            ],
            "properties": {
                "policyRules": [
                    {
                        "lifecycles": [
                            {
                                "deleteAfter": {
                                    "objectType": "AbsoluteDeleteOption",
                                    "duration": "[concat('P', parameters('backupRetentionDays'), 'D')]"
                                },
                                "targetDataStoreCopySettings": [],
                                "sourceDataStore": {
                                    "dataStoreType": "OperationalStore",
                                    "objectType": "DataStoreInfoBase"
                                }
                            }
                        ],
                        "isDefault": true,
                        "name": "Default_OperationalStore",
                        "objectType": "AzureRetentionRule"
                    },
                    {
                        "lifecycles": [
                            {
                                "deleteAfter": {
                                    "objectType": "AbsoluteDeleteOption",
                                    "duration": "[concat('P', parameters('backupRetentionDays'), 'D')]"
                                },
                                "targetDataStoreCopySettings": [],
                                "sourceDataStore": {
                                    "dataStoreType": "VaultStore",
                                    "objectType": "DataStoreInfoBase"
                                }
                            }
                        ],
                        "isDefault": true,
                        "name": "Default",
                        "objectType": "AzureRetentionRule"
                    },
                    {
                        "backupParameters": {
                            "backupType": "Discrete",
                            "objectType": "AzureBackupParams"
                        },
                        "trigger": {
                            "schedule": {
                                "repeatingTimeIntervals": [
                                    "R/2026-05-21T05:00:00+00:00/P1D"
                                ],
                                "timeZone": "Coordinated Universal Time"
                            },
                            "taggingCriteria": [
                                {
                                    "tagInfo": {
                                        "tagName": "Default"
                                    },
                                    "taggingPriority": 99,
                                    "isDefault": true
                                }
                            ],
                            "objectType": "ScheduleBasedTriggerContext"
                        },
                        "dataStore": {
                            "dataStoreType": "VaultStore",
                            "objectType": "DataStoreInfoBase"
                        },
                        "name": "BackupDaily",
                        "objectType": "AzureBackupRule"
                    }
                ],
                "datasourceTypes": [
                    "Microsoft.Storage/storageAccounts/blobServices"
                ],
                "objectType": "BackupPolicy"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[variables('roleAssignmentName')]",
            "dependsOn": [
                "[resourceId('Microsoft.DataProtection/backupVaults', parameters('vaultName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
                "principalId": "[reference(resourceId('Microsoft.DataProtection/backupVaults', parameters('vaultName')), '2026-03-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.DataProtection/backupVaults/backupInstances",
            "apiVersion": "2026-03-01",
            "name": "[concat(parameters('vaultName'), '/', variables('backupInstanceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.DataProtection/backupVaults', parameters('vaultName'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', variables('roleAssignmentName'))]",
                "[resourceId('Microsoft.DataProtection/BackupVaults/backupPolicies', parameters('vaultName'), 'DailyPolicy')]"
            ],
            "properties": {
                "friendlyName": "[parameters('storageAccountName')]",
                "dataSourceInfo": {
                    "resourceID": "[resourceId(parameters('resourceGroupName'), 'Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
                    "resourceUri": "[resourceId(parameters('resourceGroupName'), 'Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
                    "datasourceType": "Microsoft.Storage/storageAccounts/blobServices",
                    "resourceName": "[parameters('storageAccountName')]",
                    "resourceType": "Microsoft.Storage/storageAccounts",
                    "resourceLocation": "[parameters('resourceGroupLocation')]",
                    "objectType": "Datasource"
                },
                "policyInfo": {
                    "policyId": "[resourceId('Microsoft.DataProtection/BackupVaults/backupPolicies', parameters('vaultName'), 'DailyPolicy')]",
                    "policyParameters": {
                        "backupDatasourceParametersList": [
                            {
                                "objectType": "BlobBackupDatasourceParameters",
                                "containersList": [
                                    "pdm",
                                    "pimcore"
                                ]
                            }
                        ]
                    }
                },
                "objectType": "BackupInstance"
            }
        }
    ],
    "outputs": {
    }
}
